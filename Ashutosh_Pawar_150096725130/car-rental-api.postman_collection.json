{
  "info": {
    "name": "Car Rental API - Ashutosh Pawar (150096725130)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom. Before 'Login Admin', promote the admin in the Supabase SQL Editor: update profiles set role = 'admin' where email = 'admin@travel.com'; Dates are set relative to today by the collection pre-request script (booking = today to today+4, overlap test = today+2 to today+6)."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const day = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };",
          "pm.collectionVariables.set(\"startDate\", day(0));",
          "pm.collectionVariables.set(\"endDate\", day(4));",
          "pm.collectionVariables.set(\"overlapStart\", day(2));",
          "pm.collectionVariables.set(\"overlapEnd\", day(6));",
          "pm.collectionVariables.set(\"laterStart\", day(5));",
          "pm.collectionVariables.set(\"laterEnd\", day(7));",
          "pm.collectionVariables.set(\"futureStart\", day(10));",
          "pm.collectionVariables.set(\"futureEnd\", day(12));"
        ]
      }
    }
  ],
